# Copy this file to .env.test.local (git-ignored, see .gitignore's *.env
# pattern) for running/debugging tests directly from VS Code, outside
# Docker. This is separate from .env (used by docker-compose) because
# the hostname for Postgres is different depending on where the process
# runs:
#
#   - Inside the `api` container (docker-compose): host is "db"
#     (Docker's internal DNS resolves the service name).
#   - On your machine via VS Code (this file): host is "localhost",
#     since docker-compose.yml maps the db container's 5432 to your
#     host's 5432 ("ports: - 5432:5432").
#
# Requires `docker-compose up db` (or the full stack) running in the
# background so Postgres is actually reachable on localhost:5432.

SECRET_KEY=local-dev-secret-key-not-for-production
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://stock_user:stock_password@localhost:5432/stock_db
DJANGO_SETTINGS_MODULE=config.settings.development
CORS_ALLOWED_ORIGINS=http://localhost:3000
IDEMPOTENCY_KEY_REQUIRED=True
